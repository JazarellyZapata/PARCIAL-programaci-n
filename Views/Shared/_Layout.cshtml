@using Microsoft.AspNetCore.Identity
@using PARCIAL_programaci_n.Data 
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal Académico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PARCIAL_programaci_n.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* MODIFICADO: Clase bg-pink-nav para el color rosa de la barra *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-pink-nav border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Portal Académico</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        
                        @* Lógica para mostrar los menús condicionales (P2 y P3) *@
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            
                            // Asegura que el usuario no sea nulo antes de verificar el rol
                            if (user != null) 
                            {
                                var isCoordinador = await UserManager.IsInRoleAsync(user, "Coordinador");

                                if (isCoordinador)
                                {
                                    @* Menú del Coordinador (P2: Gestión de Cursos) *@
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Administración
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                            <li><a class="dropdown-item" asp-controller="Cursos" asp-action="Index">Gestión de Cursos</a></li>
                                        </ul>
                                    </li>
                                }
                                else 
                                {
                                    @* Menú del Estudiante (P3: Matrículas) *@
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-controller="Estudiante" asp-action="Catalogo">Catálogo de Cursos</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-controller="Estudiante" asp-action="Matriculas">Mis Matrículas</a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                    
                    @* Renderiza la vista parcial para Login/Register/Logout *@
                    <partial name="_LoginPartial" /> 
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Portal Académico - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>