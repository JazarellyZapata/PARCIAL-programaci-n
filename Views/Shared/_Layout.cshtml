<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PARCIAL_programaci_n</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PARCIAL_programaci_n.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sistema de Matrículas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        
                        @{
                            // Lógica de Roles
                            var isCoordinador = User.IsInRole("Coordinador");
                            var isAuthenticated = User.Identity!.IsAuthenticated;
                        }

                        @if (isAuthenticated && isCoordinador)
                        {
                            // === ENLACES PARA EL COORDINADOR (P2 & P5) ===
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cursos" asp-action="Index">Gestión de Cursos (P2)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Coordinador" asp-action="Dashboard">Panel Asistencia (P5)</a>
                            </li>
                        }
                        else if (isAuthenticated)
                        {
                            // === ENLACES PARA EL ESTUDIANTE (P3 & P4) ===
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Estudiante" asp-action="Catalogo">Catálogo de Cursos (P3)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Estudiante" asp-action="Matriculas">Mis Matrículas / Créditos (P4)</a>
                            </li>
                        }
                    </ul>
                    
                    {{-- Renderiza los enlaces de Login/Register/Logout de Identity --}}
                    <partial name="_LoginPartial" /> 

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["StatusMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PARCIAL_programaci_n - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>