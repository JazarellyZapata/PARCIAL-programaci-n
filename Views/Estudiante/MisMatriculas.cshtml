@model IEnumerable<PARCIAL_programaci_n.Models.Matricula>

@{
    ViewData["Title"] = "Mis Matrículas";
}

<h1>Mis Cursos Inscritos</h1>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Aún no estás matriculado en ningún curso. ¡Visita el <a asp-action="Catalogo">Catálogo</a>!
    </div>
}
else
{
    @foreach (var matricula in Model)
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4>@matricula.Curso!.Nombre (@matricula.Curso.Codigo)</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Fecha de Inscripción:</dt>
                    <dd class="col-sm-9">@matricula.FechaMatricula.ToShortDateString()</dd>
                    <dt class="col-sm-3">Créditos:</dt>
                    <dd class="col-sm-9">@matricula.Curso.Creditos</dd>
                </dl>

                <h5>Sesiones y Asistencia</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Estado de Asistencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sesion in matricula.Curso.Sesiones!.OrderBy(s => s.Fecha))
                        {
                            // Busca la asistencia específica del usuario para esta sesión
                            var asistencia = sesion.Asistencias?.FirstOrDefault(a => a.UsuarioId == matricula.UsuarioId);
                            string estado = asistencia != null ? (asistencia.Presente ? "Presente" : "Ausente") : "Pendiente";
                            string cssClass = estado switch
                            {
                                "Presente" => "table-success",
                                "Ausente" => "table-danger",
                                _ => ""
                            };

                            <tr class="@cssClass">
                                <td>@sesion.Fecha.ToString("dd-MM-yyyy HH:mm")</td>
                                <td>@sesion.Tema</td>
                                <td>@estado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}