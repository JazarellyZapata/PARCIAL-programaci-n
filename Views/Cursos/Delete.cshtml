@model PARCIAL_programaci_n.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<h1>Eliminar Curso</h1>

<h3 class="text-danger">¿Está seguro que desea eliminar este curso? Esta acción no se puede deshacer.</h3>
<div>
    <h4>@Model.Nombre</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Codigo)</dd>
        
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Creditos)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Creditos)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-9">@(Model.Activo ? "Activo" : "Inactivo")</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar y Volver al Listado</a>
    </form>
</div>