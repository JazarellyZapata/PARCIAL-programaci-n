@model IEnumerable<PARCIAL_programaci_n.Models.Curso>

@{
    ViewData["Title"] = "Administración de Cursos";
}

<div class="row">
    <div class="col-md-12">
        <h2 class="text-primary mb-4">@ViewData["Title"]</h2>

        <p>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Crear Nuevo Curso
            </a>
        </p>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="bg-primary text-white">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Codigo)</th>
                        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Creditos)</th>
                        <th>@Html.DisplayNameFor(model => model.CupoMaximo)</th>
                        <th>Horario</th>
                        <th>@Html.DisplayNameFor(model => model.Activo)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.Creditos)</td>
                            <td>@Html.DisplayFor(modelItem => item.CupoMaximo)</td>
                            <td>@item.HorarioInicio.ToString(@"hh\:mm") - @item.HorarioFin.ToString(@"hh\:mm")</td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.Activo ? "btn-danger" : "btn-success")" title="@(item.Activo ? "Desactivar" : "Activar")">
                                        <i class="bi @(item.Activo ? "bi-lock" : "bi-unlock")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>