@model PARCIAL_programaci_n.Models.Curso

@{
    ViewData["Title"] = $"Gestión de Sesiones: {Model.Nombre}";
    // Obtener la lista de sesiones ordenadas por fecha
    var sesiones = Model.Sesiones?.OrderBy(s => s.Fecha).ToList() ?? new List<Sesion>();
}

<h1>Gestión de Sesiones del Curso: @Model.Nombre</h1>
<p>Código: @Model.Codigo</p>

<hr />

@* Sección para Crear una Nueva Sesión *@
<div class="row mb-4">
    <div class="col-md-6">
        <h3>Crear Nueva Sesión</h3>
        @* La acción 'CrearSesion' debe estar implementada en CoordinadorController *@
        <form asp-controller="Coordinador" asp-action="CrearSesion" method="post">
            <input type="hidden" name="cursoId" value="@Model.Id" />
            
            <div class="form-group">
                <label for="Fecha" class="control-label">Fecha y Hora</label>
                @* Usamos el input type="datetime-local" para facilitar la entrada, y el nombre es "Fecha" *@
                <input name="Fecha" type="datetime-local" class="form-control" required />
            </div>
            
            <div class="form-group">
                <label for="Tema" class="control-label">Tema de la Sesión</label>
                <input name="Tema" type="text" class="form-control" required />
            </div>
            
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-success">Crear Sesión</button>
            </div>
        </form>
    </div>
</div>

<hr />

@* Sección de Listado de Sesiones Existentes *@
<h3>Sesiones Programadas (@sesiones.Count)</h3>

@if (sesiones.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha y Hora</th>
                <th>Tema</th>
                <th>Matriculados</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sesion in sesiones)
            {
                <tr>
                    @* Corregido para usar .Fecha *@
                    <td>@sesion.Fecha.ToString("dd-MM-yyyy HH:mm")</td> 
                    <td>@sesion.Tema</td>
                    <td>@(Model.Matriculas?.Count ?? 0)</td>
                    <td>
                        @* Botón Tomar Asistencia *@
                        <a asp-controller="Coordinador" asp-action="TomarAsistencia" asp-route-sesionId="@sesion.Id" class="btn btn-sm btn-info">Tomar Asistencia</a>
                        
                        @* Formulario para Eliminar Sesión *@
                        <form asp-controller="Coordinador" asp-action="EliminarSesion" method="post" class="d-inline"
                              onsubmit="return confirm('¿Está seguro de eliminar esta sesión? Esta acción es irreversible.');">
                            <input type="hidden" name="sesionId" value="@sesion.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            } @* <-- El cierre del foreach es clave para el balance de <tr> *@
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No hay sesiones programadas para este curso.</div>
}

<div class="mt-4">
    <a asp-controller="Coordinador" asp-action="Index" class="btn btn-secondary">Volver al Panel de Coordinador</a>
</div>