@model List<PARCIAL_programaci_n.Models.Curso>
@{
    ViewData["Title"] = "Panel de Gestión de Asistencia";
}

<h1>Panel de Gestión de Asistencia</h1>
<p>Seleccione un curso para gestionar sus sesiones y tomar asistencia.</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Codigo)</th>
            <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
            <th>Créditos</th>
            <th>Cupo Máximo</th>
            <th>Matriculados</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Creditos)</td>
                <td>@Html.DisplayFor(modelItem => item.CupoMaximo)</td>
                <td>@(item.Matriculas?.Count ?? 0)</td>
                <td>
                    @(item.Activo ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="GestionarSesiones" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                        Gestionar Sesiones
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>